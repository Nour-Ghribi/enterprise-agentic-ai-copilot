# Offline deterministic demo: no generative LLM inference, API keys or LLM runtime required.
LLM_MODE=offline
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
LLM_MAX_OUTPUT_TOKENS=2500
AGENT_MAX_TURNS=12
AGENT_MAX_TOOL_CALLS=40
AGENT_TIMEOUT_SECONDS=600

# Optional external providers: deliberately UNCONFIGURED.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_FOUNDRY_MODE=mock
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_MODEL=
AZURE_FOUNDRY_API_KEY=

# Business adapters stay mock unless explicitly configured for real read-only access.
CRM_MODE=mock
CRM_PROVIDER=salesforce
ERP_MODE=mock
CRM_ID_MAP_PATH=
ERP_ID_MAP_PATH=
REAL_AS_OF_DATE=
SALESFORCE_ENDPOINT=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_API_VERSION=v66.0
DYNAMICS365_ENDPOINT=
DYNAMICS365_ACCESS_TOKEN=
SAP_ENDPOINT=
SAP_ACCESS_TOKEN=
# SAP financial service/schema and CRM status semantics vary by tenant.
SAP_OPEN_ITEMS_PATH=
SAP_INVOICE_FIELD_MAP=
CRM_TICKET_SEVERITY_MAP=
CRM_TICKET_STATUS_MAP=

# Cache-only local embeddings; explicit lexical fallback when the cache is missing.
SEMANTIC_ENABLED=1
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_MIN_SIMILARITY=0.25
APPROVAL_TOKEN=local-demo-approver
COPILOT_API_URL=http://127.0.0.1:8000
# COPILOT_DATA_DIR=C:/path/to/local/data
# SEMANTIC_CACHE_DIR=C:/path/to/local/model/cache
